node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.log
MUJOCO_LOG.TXT
.DS_Store
outputs/
runs/
wandb/
.env
*.onnx

# 上游原始 mesh（可用 tools/robot/fetch_meshes.py 重新拉，不入库）
third_party/*/meshes/
third_party/*/assets/

# onnxruntime-web 的运行时（14 MB），用 tools/vendor_ort_web.py 抓
client/viewer/vendor/ort/
client/viewer/vendor/mujoco/
# 浏览器自算用的策略权重（*.onnx 已在上面统一忽略）
client/viewer/data/live/*.onnx
# 浏览器物理用的 STL（21 MB），用 tools/vendor_mujoco_web.py 抓
client/viewer/assets/mjcf/

# botlab 上游模板包（220MB，用 tools/dev/grab_botlab_templates.mjs 可重新拉）
third_party/botlab-templates/*.zip
